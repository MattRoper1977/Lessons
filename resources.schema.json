{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matt's Apps lesson catalogue",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "subject",
      "title",
      "file",
      "type",
      "family",
      "keywords"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "subject": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "file": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "lesson",
          "game",
          "revision",
          "pupil",
          "teacher",
          "support"
        ]
      },
      "family": {
        "type": "string",
        "minLength": 1
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "added": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "new": {
        "type": "boolean"
      },
      "desc": {
        "type": "string"
      },
      "thumb": {
        "type": "string"
      }
    }
  }
}
